# Ecobase image builds use the NocoBase repository root as context.
# Keep build-context pruning plugin-local so upstream .dockerignore stays unchanged.
storage
node_modules
.git

**/.umi
**/.umi-production

packages/*/*/lib
packages/*/*/esm
packages/*/*/es
packages/*/*/dist
packages/*/*/node_modules
packages/*/*/*/lib
packages/*/*/*/esm
packages/*/*/*/es
packages/*/*/*/dist
packages/*/*/*/node_modules

/.vscode
/.idea

*.sqlite
*.sql
/uploads

# Local live-gate backups and generated plugin scratch data are not build inputs.
packages/plugins/@nocobase/plugin-ecobase/tmp
packages/plugins/@nocobase/plugin-ecobase/tmp/**
**/live-gate-backups
**/live-gate-backups/**
